# Public browser Maps Client ID only. Never put Client Secret or collection/LLM keys here.
REACT_APP_NAVER_MAP_CLIENT_ID=
# Optional public My Style ID, published through Naver Map Style Editor.
REACT_APP_NAVER_MAP_STYLE_ID=

# Optional Spring origin; empty uses the local /api proxy to port 8080.
REACT_APP_API_BASE_URL=
